{
    "name": "haroone/module-admin-reindex",
    "description": "Adds queued Reindex and Reset actions with live progress, worker-health warnings, and duplicate-job protection to Magento 2 Index Management.",
    "type": "magento2-module",
    "license": "MIT",
    "keywords": [
        "magento2",
        "magento2-extension",
        "adobe-commerce",
        "admin",
        "indexer",
        "reindex",
        "reset",
        "message-queue",
        "bulk-operations",
        "background"
    ],
    "authors": [
        {
            "name": "Haroone Agency",
            "homepage": "https://haroone.com"
        }
    ],
    "homepage": "https://haroone.com/extensions/magento-2-admin-reindex",
    "support": {
        "issues": "https://github.com/haroonsulahri/magento2-admin-reindex/issues",
        "source": "https://github.com/haroonsulahri/magento2-admin-reindex"
    },
    "require": {
        "php": "^8.1",
        "magento/framework": "^103.0.4",
        "magento/framework-bulk": "^101.0.1",
        "magento/module-asynchronous-operations": "^100.4.4",
        "magento/module-authorization": "^100.4.4",
        "magento/module-backend": "^102.0.4",
        "magento/module-cron": "^100.4.4",
        "magento/module-indexer": "^100.4.4",
        "magento/module-message-queue": "^100.4.4"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Haroone\\AdminReindex\\": ""
        }
    }
}
